# EditorConfig keeps whitespace consistent across editors (VS Code, WebStorm, Vim...).
# Most editors support it natively or with a small plugin: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses trailing double-spaces for line breaks, so don't strip them.
trim_trailing_whitespace = false
